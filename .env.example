# ClipForge AI — Environment Configuration

# Core Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="ClipForge AI"
API_V1_STR=/api

# Database
DATABASE_URL=sqlite:///./clipforge.db

# Background Tasks
USE_LOCAL_QUEUE=True

# External Local Video Storage (Strictly Isolated Outside Project Workspace)
MEDIA_STORAGE_PATH=D:/AI_Video_Storage
TEMP_MEDIA_PATH=D:/AI_Video_Temp
ENABLE_DRAFT_STORAGE=True

# Storage
STORAGE_BACKEND=local
# S3 Configuration (Optional for cloud object storage)
# S3_BUCKET=clipforge-videos
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key

# Limits & Tools
MAX_UPLOAD_SIZE_MB=500
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Demo Mode (Set True to fall back to local FFmpeg synthesis when API keys are absent)
DEMO_MODE=True

# ==============================================================================
# PRIVACY-AWARE MODEL ROUTER & GOVERNANCE
# ==============================================================================
# Privacy Tiers:
# - strict_local: 100% offline, zero cloud API calls. Uses Ollama local LLM, Edge-TTS, local FFmpeg.
# - private_hybrid: Default. Keeps metadata & media strictly local. Allows approved cloud generation.
# - cloud_assisted: Unlocks full multi-cloud generation models (Veo, Runway, Luma, Kling, Seedance, ElevenLabs).
PRIVACY_MODE=strict_local

# Global Cloud Kill Switch: if false, blocks all external outbound API calls regardless of mode
ALLOW_CLOUD_TRANSFERS=false

# Cloud Provider Allowlist (comma-separated or JSON list)
CLOUD_PROVIDER_ALLOWLIST=["gemini","veo","runway","luma","kling","seedance","firefly","elevenlabs","whisper","pollinations"]

# ==============================================================================
# AI PROVIDERS CONFIGURATION
# ==============================================================================

# 1. Visual Video Provider
# Options: "veo", "runway", "luma", "kling", "seedance", "firefly", "pika", "pollinations" [FREE], "mock"
VIDEO_PROVIDER=pollinations
VIDEO_API_KEY=

# 2. Audio & Voiceover Provider
# Options: "edge_tts" [FREE Studio Neural TTS], "elevenlabs", "openai", "mock"
AUDIO_PROVIDER=edge_tts
AUDIO_API_KEY=

# 3. LLM Script & Storyboard Director
# Options: "gemini" [FREE tier at Google AI Studio], "ollama" [100% Offline Local], "mock"
LLM_PROVIDER=mock
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# 4. Speech Transcription Provider
# Options: "whisper" [Groq Whisper or OpenAI Whisper], "mock"
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_API_KEY=
