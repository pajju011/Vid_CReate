# ClipForge AI — Environment Configuration

# Core Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="ClipForge AI"
API_V1_STR=/api

# Database
# Default: Local SQLite for zero-dependency development
DATABASE_URL=sqlite:///./clipforge.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clipforge

# Background Tasks & Redis
REDIS_URL=redis://localhost:6379/0
USE_LOCAL_QUEUE=True

# External Local Video Storage (Outside Project Directory)
MEDIA_STORAGE_PATH=D:/AI_Video_Storage
TEMP_MEDIA_PATH=D:/AI_Video_Temp
ENABLE_DRAFT_STORAGE=True

# Storage
STORAGE_BACKEND=local
# S3 Configuration (Optional for production)
# S3_BUCKET=clipforge-videos
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key

# Limits & Tools
MAX_UPLOAD_SIZE_MB=500
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Demo Mode (Set True to fall back to local FFmpeg video synthesis when API keys are absent)
DEMO_MODE=True

# --- AI Providers Configuration ---

# 1. Visual Video Provider ("pollinations" [FREE, No Key], "luma", "runway", "kling", "pika", or "mock")
VIDEO_PROVIDER=pollinations
VIDEO_API_KEY=

# 2. Audio & Voiceover Provider ("edge_tts" [FREE, No Key], "elevenlabs", "openai", or "mock")
AUDIO_PROVIDER=edge_tts
AUDIO_API_KEY=

# 3. LLM Script & Storyboard Director ("gemini" [FREE tier at https://aistudio.google.com/], or "mock")
LLM_PROVIDER=mock
LLM_API_KEY=

# 4. Speech Transcription Provider ("whisper" [FREE tier at https://console.groq.com/], or "mock")
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_API_KEY=

