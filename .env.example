# ClipForge AI — Environment Configuration

# Core Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="ClipForge AI"
API_V1_STR=/api

# Database
# Default: Local SQLite for zero-dependency development
DATABASE_URL=sqlite:///./clipforge.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clipforge

# Background Tasks & Redis
REDIS_URL=redis://localhost:6379/0
USE_LOCAL_QUEUE=True

# Storage
STORAGE_BACKEND=local
# S3 Configuration (Optional for production)
# S3_BUCKET=clipforge-videos
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key

# Limits & Tools
MAX_UPLOAD_SIZE_MB=500
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Demo Mode (Set True to fall back to local FFmpeg video synthesis when API keys are absent)
DEMO_MODE=True

# --- AI Providers Configuration ---

# 1. LLM Provider ("gemini", "openai", or "mock")
LLM_PROVIDER=mock
LLM_API_KEY=

# 2. Video Provider ("luma", "runway", or "mock")
VIDEO_PROVIDER=mock
VIDEO_API_KEY=

# 3. Audio & Voiceover Provider ("elevenlabs", "openai", or "mock")
AUDIO_PROVIDER=mock
AUDIO_API_KEY=

# 4. Speech Transcription Provider ("whisper" or "mock")
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_API_KEY=

